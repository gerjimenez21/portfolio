                                  "gap": 8,
                                  "padding": "$radius-xl",
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "ybhri",
                                      "name": "Title",
                                      "fill": "#F0EFF8",
                                      "content": "Universal Search",
                                      "fontFamily": "Open Sans",
                                      "fontSize": 16,
                                      "fontWeight": "700"
                                    },
                                    {
                                      "type": "text",
                                      "id": "y32iiV",
                                      "name": "Body",
                                      "fill": "#7B78A8",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "Universal Search reúne en un solo lugar la búsqueda de Humand. Para llegar ahí hicimos pruebas de usabilidad y entrevistas para entender cómo buscan los colaboradores. La adopción esperada se alcanzó y se superó: cerca del 15% de los usuarios activos del mes hace al menos una búsqueda. En los principales clientes el uso llegó a su objetivo, y en el de mayor adopción lo pasó. Hoy se siguen sumando miniapps a los resultados, y seguimos iterando.",
                                      "lineHeight": 1.625,
                                      "fontFamily": "Open Sans",
                                      "fontSize": 14,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
