                                    },
                                    {
                                      "type": "text",
                                      "id": "j7rGG",
                                      "name": "Body",
                                      "fill": "#7B78A8",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "La miniapp de Celebrations les da a las comunidades de Humand un lugar donde celebrar. El entorno reúne el widget, que ya existía, el feed y el calendario. También cambié cómo se configuran desde el admin.",
                                      "lineHeight": 1.625,
